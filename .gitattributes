# Checkout and store text as LF (avoid CRLF noise on Windows).
* text=auto eol=lf

*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

*.wav binary
*.pcm binary
*.png binary
